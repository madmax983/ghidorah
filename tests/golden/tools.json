  {
    "name": "fact_check",
    "title": "Check claims and explain facts",
    "description": "Check claims with supported, refuted or unknown verdicts, and explain why a fact exists. Send claims with a relation and its arguments, for example calls with the arguments main and imp:puts. Send explain with fact IDs to get the why tree of each fact. A refuted verdict is sound: the facts that the relation reads are complete. An indirect call with no target gives unknown, and basis.gaps lists the sites that block a refuted verdict. Call func_edit with the action set_call_targets to give a site its targets.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rel": {
