  {
    "name": "binary_load",
    "title": "Load a binary",
    "description": "Load a binary for analysis: an ELF or PE file under a root, a raw blob, the built-in demo or an open binary by its ID. Send exactly one of path, builtin and binary_id. Send file_format raw and base for a blob of x86-64 code. The analysis runs after the load within max_steps. Use the binary_id of the result in later calls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "builtin": {
          "enum": [
            "demo"
          ]
        },
        "binary_id": {
          "type": "string"
        },
        "file_format": {
          "enum": [
            "auto",
            "elf",
            "pe",
            "raw"
          ]
        },
        "arch": {
          "enum": [
            "x86_64"
          ]
        },
        "base": {
          "type": [
            "integer",
            "string"
          ]
        },
        "entry": {
          "type": [
            "integer",
            "string"
          ]
        },
        "analysis": {
          "enum": [
            "none",
            "triage",
            "full"
          ]
        },
        "break_lock": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "max_steps": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
